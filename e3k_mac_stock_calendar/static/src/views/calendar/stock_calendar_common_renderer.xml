<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- Override the event template for stock.picking model -->
    <t t-name="web.CalendarCommonRenderer.event" t-inherit="web.CalendarCommonRenderer.event" t-inherit-mode="extension">
        <!-- Replace the default event title rendering -->
        <xpath expr="//div[@class='o_event_title']" position="replace">
            <!-- Default rendering for non-stock.picking models -->
            <t t-if="resModel != 'stock.picking'">
                <div class="o_event_title" t-out="title"/>
            </t>

            <!-- Custom rendering for stock.picking model -->
            <t t-else="">
                <div class="o_event_title d-flex align-items-center justify-content-between"
                     style="margin: 0px; height: 30px; padding: 2px 4px;">

                    <!-- Display custom name -->
                    <span t-esc="rawRecord.e3k_custom_display_name"
                          style="display: inline-block; margin-right: 15px; flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;"/>

                    <!-- Black dot indicator for 'assigned' state -->
                    <div t-if="rawRecord.state == 'assigned'"
                         style="width: 10px; height: 10px; background-color: black; border-radius: 50%; flex-shrink: 0;"/>
                </div>
            </t>
        </xpath>
    </t>

</templates>
