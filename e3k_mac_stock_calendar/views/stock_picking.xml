<?xml version="1.0"?>
<odoo>
    <record id="e3k_vpicktree" model="ir.ui.view">
        <field name="name">e3k.stock.picking.tree</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.vpicktree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='date_deadline']" position="attributes">
                <attribute name="widget">date</attribute>
            </xpath>
            <xpath expr="//field[@name='state']" position="after">
                <field name="note" optional="show"/>
                <field name="delivery_pickup" widget="boolean_toggle" string="Delivery Pickup"/>
                <field name="worksite_ready" widget="boolean_toggle"/>
                <field name="flexible_date" widget="boolean_toggle"/>
                <field name="e3k_delivery_on_hold" widget="boolean_toggle"/>
            </xpath>
            <xpath expr="//field[@name='scheduled_date']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='scheduled_date']" position="after">
                <xpath expr="//field[@name='date_deadline']" position="move"/>
            </xpath>
        </field>
    </record>
    <record id="e3k_view_picking_internal_search" model="ir.ui.view">
        <field name="name">e3k.stock.picking.internal.search</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_internal_search"/>
        <field name="arch" type="xml">
            <xpath expr="//separator[1]" position="before">
                <field name="note" optional="show"/>
                <field name="delivery_pickup" widget="boolean_toggle"/>
                <field name="worksite_ready" widget="boolean_toggle"/>
                <filter name="allowed" string="Allowed states"
                        domain="['&amp;','&amp;', ['picking_type_id', '=', 1], ['state', 'in', ['draft', 'waiting', 'confirmed', 'assigned']], ['e3k_delivery_on_hold', '!=', True]]"/>
            </xpath>
            <xpath expr="//filter[@name='late']" position="replace">
             <filter string="Planning Issues"
                     name="planning_issues"
                     help="Transfers that are late on scheduled time or one of pickings will be late"
                     domain="['&amp;', ('scheduled_date','&lt;', time.strftime('%Y-%m-%d %H:%M:%S')), ('state', 'in', ('draft', 'assigned', 'waiting', 'confirmed'))]"/>
            </xpath>
        </field>
    </record>

    <record model="ir.ui.view" id="stock_picking_calendar">
        <field name="name">stock.picking.calendar</field>
        <field name="model">stock.picking</field>
        <field name="priority" eval="1"/>
        <field name="arch" type="xml">
            <calendar string="Calendar View"
                      date_start="date_deadline"
                      color="partner_id"
                      event_limit="5"
                      quick_create="1"
                      mode="week"
                      delete="false"
                      all_day="e3k_all_day"

            >

                <field name="partner_id" filters="1"/>
                <field name="sale_id"/>
                <field name="state"/>
                <field name="e3k_custom_display_name" invisible="1"/>
                <field name="e3k_calendar_color" invisible="1"/>
                <field name="e3k_calendar_text_color" invisible="1"/>
                <field name="flexible_date" invisible="1"/>
                <field name="date_deadline" invisible="1"/>

            </calendar>
        </field>
    </record>


    <record id="stock.action_picking_tree_ready" model="ir.actions.act_window">
        <field name="context">{'search_default_allowed' : 1}</field>
    </record>


</odoo>
