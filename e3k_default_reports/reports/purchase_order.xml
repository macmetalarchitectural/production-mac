<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_purchaseorder_document_purchase_stock" inherit_id="purchase_stock.report_purchaseorder_document">
        <xpath expr="//t[@t-else='']" position="replace">
        </xpath>
    </template>
    <template id="report_purchase_e3k" inherit_id="purchase.report_purchaseorder_document">
        <xpath expr="//t[@t-if='o.dest_address_id']" position="replace">
            <t t-set="information_block">
                <strong>Supplier:</strong>
                <div t-field="o.partner_id" t-options="{&quot;widget&quot;: &quot;contact&quot;, &quot;fields&quot;: [&quot;address&quot;, &quot;name&quot;], &quot;no_marker&quot;: True}"/>
                <div t-field="o.partner_id.phone" class="fa fa-phone"/>
                <p t-if="o.partner_id.vat"><t t-esc="o.company_id.country_id.vat_label or 'Tax ID'"/>:
                    <span t-field="o.partner_id.vat"/>
                </p>
            </t>
        </xpath>
        <xpath expr="//t[@t-set='address']" position="replace">
            <t t-set="address">
                <t t-if="o.dest_address_id">
                    <strong>Shipping address:</strong>
                    <div t-if="o.dest_address_id">
                        <div t-field="o.dest_address_id" t-options="{&quot;widget&quot;: &quot;contact&quot;, &quot;fields&quot;: [&quot;address&quot;, &quot;name&quot;], &quot;no_marker&quot;: True}" name="purchase_shipping_address"/>
                        <div t-field="o.partner_id.phone" class="fa fa-phone"/>
                    </div>
                </t>
                <t t-else="">
                    <strong>Shipping address:</strong>
                    <div t-if="o.picking_type_id and o.picking_type_id.warehouse_id">
                        <span t-field="o.picking_type_id.warehouse_id.name"/>
                        <div t-field="o.picking_type_id.warehouse_id.partner_id" t-options="{&quot;widget&quot;: &quot;contact&quot;, &quot;fields&quot;: [&quot;address&quot;], &quot;no_marker&quot;: True}"/>
                        <div t-field="o.partner_id.phone" class="fa fa-phone"/>
                    </div>
                </t>
            </t>
        </xpath>
        <xpath expr="//t[@t-set='layout_document_title']" position="replace">
            <t t-set="layout_document_title">
                <t t-if="o.state in ['draft', 'sent', 'to approve']">Request for Quotation N°
                    <span t-field="o.name"/>
                </t>
                <t t-if="o.state in ['purchase', 'done']">Purchase Order N°
                    <span t-field="o.name"/>
                </t>
                <t t-if="o.state == 'cancel'">Cancelled Purchase Order N°
                    <span t-field="o.name"/>
                </t>
            </t>
        </xpath>
        <xpath expr="//p[@t-field='o.date_approve']" position="replace">
            <p t-field="o.date_approve" class="m-0" t-options="{&quot;format&quot;: &quot;MM/dd/yyyy&quot;}"/>
        </xpath>
        <xpath expr="//div[@t-elif='o.date_order']" position="replace">
            <div t-elif="o.date_order" class="col-3 bm-2">
                <strong>Order Date:</strong>
                <p t-field="o.date_order" class="m-0" t-options="{&quot;format&quot;: &quot;MM/dd/yyyy&quot;}"/>
            </div>
        </xpath>
        <xpath expr="//div[@t-elif='o.date_order']" position="after">
            <div t-if="o.payment_term_id and not o.incoterm_id" class="col-3 bm-2">
                <strong>Payment Terms:</strong>
                <p t-field="o.payment_term_id" class="m-0"/>
            </div>
        </xpath>
        <xpath expr="//div[@id='informations']" position="after">
            <div id="complement_informations" t-if="o.payment_term_id and o.incoterm_id" class="row mt-4 mb32">
                <div class="col-3 bm-2">
                    <strong>Payment Terms:</strong>
                    <p t-field="o.payment_term_id" class="m-0"/>
                </div>
            </div>
            <div t-if="o.partner_id.property_delivery_carrier_id" class="col-3 bm-2">
                <strong>Shipped via:</strong>
                <br/>
                <span class="m-0" t-field="o.partner_id.property_delivery_carrier_id.name"/>
            </div>
        </xpath>
        <xpath expr="//div[@t-if='o.partner_ref']" position="replace">
            <div t-if="o.partner_ref" class="col-3 bm-2">
                <strong>Supplier reference:</strong>
                <p t-field="o.partner_ref" class="m-0"/>
            </div>
        </xpath>
        <xpath expr="//div[hasclass('page')]" position="attributes">
            <attribute name="style">margin-top:30px;</attribute>
        </xpath>
        <xpath expr="//table[1]" position="replace">
            <table class="o_has_total_table table o_main_table table-borderless">
                <thead style="display: table-row-group">
                    <tr>
                        <th name="th_ref" class="text-left">
                            <strong>Product number</strong>
                        </th>
                        <th name="th_description">
                            <strong>Product</strong>
                        </th>
                        <th name="th_date_req" class="text-center">
                            <strong>Date Req.</strong>
                        </th>
                        <th name="th_quantity" class="text-right">
                            <strong>Qty</strong>
                        </th>
                        <th name="th_price_unit" class="text-right">
                            <strong>Unit Price</strong>
                        </th>
                        <th name="th_amount" class="text-right">
                            <strong>Amount</strong>
                        </th>
                    </tr>
                </thead>
                <tbody>
                    <t t-set="current_subtotal" t-value="0"/>
                    <t t-foreach="o.order_line.filtered(lambda l: l.display_type or l.product_qty != 0)" t-as="line">
                        <t t-set="current_subtotal" t-value="current_subtotal + line.price_subtotal"/>
                        <tr t-att-class="'fw-bolder o_line_section' if line.display_type == 'line_section' else 'fw-bold o_line_subsection' if line.display_type == 'line_subsection' else 'fst-italic o_line_note' if line.display_type == 'line_note' else ''">
                            <t t-if="not line.display_type">
                                <td name="account_sale_line_code">
                                    <t t-if="line.has_seller_code">
                                        <span t-esc="line.ref_seller_product_code" t-options="{'widget': 'text'}"/>
                                    </t>
                                    <t t-else="">
                                        <span t-esc="line.product_id.default_code" t-options="{'widget': 'text'}"/>
                                    </t>
                                </td>
                                <td id="product">
                                    <span t-esc="line.get_name_no_ref()"/>
                                </td>
                                <td class="text-center">
                                    <span t-field="line.date_planned" t-options="{&quot;format&quot;: &quot;MM/dd/yyyy&quot;}"/>
                                </td>
                                <td class="text-end">
                                    <span t-field="line.product_qty"/>
                                    <span t-field="line.product_uom_id.name" groups="uom.group_uom"/>
                                    <span t-if="line.product_uom_id != line.product_id.uom_id" class="text-muted small">
                                        <br/>
                                        <span t-field="line.product_uom_qty" t-options="{'widget': 'float', 'decimal_precision': 'Product Unit'}"/>
                                        <span t-field="line.product_id.uom_id"/>
                                    </span>
                                </td>
                                <td class="text-end">
                                    <span t-field="line.price_unit"/>
                                </td>
                                <td class="text-end">
                                    <span t-field="line.price_subtotal"
                                          t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                </td>
                            </t>
                            <t t-if="line.display_type in ('line_section', 'line_subsection')">
                                <td colspan="99" id="section">
                                    <span t-field="line.name"/>
                                </td>
                                <t t-set="current_section" t-value="line"/>
                                <t t-set="current_subtotal" t-value="0"/>
                            </t>
                            <t t-if="line.display_type == 'line_note'">
                                <td colspan="99" id="note">
                                    <span t-field="line.name"/>
                                </td>
                            </t>
                        </tr>
                        <t t-if="current_section and (line_last or o.order_line[line_index+1].display_type in ('line_section', 'line_subsection'))">
                            <tr class="is-subtotal text-end">
                                <td colspan="99" id="subtotal">
                                    <strong class="mr16">Subtotal</strong>
                                    <span
                                            t-out="current_subtotal"
                                            t-options='{"widget": "monetary", "display_currency": o.currency_id}'
                                    />
                                </td>
                            </tr>
                        </t>
                    </t>
                </tbody>
            </table>

        </xpath>

    </template>

    <template id="report_purchase_quotation_e3k" inherit_id="purchase.report_purchasequotation_document">
        <xpath expr="//div[hasclass('page')]" position="attributes">
            <attribute name="style">margin-top:30px;</attribute>
        </xpath>
        <xpath expr="//div[hasclass('page')]" position="before">
            <t t-set="address">
                <t t-if="o.dest_address_id">
                    <strong>Shipping address:</strong>
                    <div t-if="o.dest_address_id">
                        <div t-field="o.dest_address_id"
                             t-options='{"widget": "contact", "fields": ["address", "name"], "no_marker": True}' name="purchase_shipping_address"/>
                        <div t-field="o.partner_id.phone" class="fa fa-phone"/>
                    </div>
                </t>
                <t t-else="">
                    <strong>Shipping address:</strong>
                    <div t-if="o.picking_type_id and o.picking_type_id.warehouse_id">
                        <span t-field="o.picking_type_id.warehouse_id.name"/>
                        <div t-field="o.picking_type_id.warehouse_id.partner_id" t-options='{"widget": "contact", "fields": ["address"], "no_marker": True}'/>
                        <div t-field="o.partner_id.phone" class="fa fa-phone"/>
                    </div>
                </t>
            </t>
            <t t-set="information_block">
                <strong>Supplier:</strong>
                <div t-field="o.partner_id"
                     t-options='{"widget": "contact", "fields": ["address", "name"], "no_marker": True}'/>
                <div t-field="o.partner_id.phone" class="fa fa-phone"/>
                <p t-if="o.partner_id.vat"><t t-esc="o.company_id.country_id.vat_label or 'Tax ID'"/>:
                    <span t-field="o.partner_id.vat"/>
                </p>
            </t>
        </xpath>
        <xpath expr="//t[@t-set='layout_document_title']" position="replace">
            <t t-set="layout_document_title">
                <span>Request for Quotation N°
                    <span t-field="o.name"/>
                </span>
            </t>
        </xpath>
        <xpath expr="//table[1]" position="replace">
            <table class="table table-sm">
                <thead>
                    <tr>
                        <th name="th_ref" class="text-left">
                            <strong>Product number</strong>
                        </th>
                        <th name="th_description">
                            <strong>Product</strong>
                        </th>
                        <th name="th_expected_date" class="text-center">
                            <strong>Expected Date</strong>
                        </th>
                        <th name="th_quantity" class="text-right">
                            <strong>Qty</strong>
                        </th>
                    </tr>
                </thead>
                <tbody>
                    <t t-foreach="o.order_line.filtered(lambda l: l.display_type or l.product_qty != 0)" t-as="order_line">
                        <tr t-att-class="'fw-bolder o_line_section' if order_line.display_type == 'line_section' else 'fw-bold o_line_subsection' if order_line.display_type == 'line_subsection' else 'fst-italic o_line_note' if order_line.display_type == 'line_note' else ''">
                            <t t-if="not order_line.display_type">
                                <td id="ref">
                                    <t t-if="order_line.has_seller_code">
                                        <span t-esc="order_line.ref_seller_product_code"/>
                                    </t>
                                    <t t-else="">
                                        <span t-esc="order_line.product_id.default_code"/>
                                    </t>
                                </td>
                                <td id="product">
                                    <span t-esc="order_line.get_name_no_ref()"/>
                                </td>
                                <td class="text-center">
                                    <span t-field="order_line.date_planned" t-options='{"format": "MM/dd/yyyy"}'/>
                                </td>
                                <td class="text-end">
                                    <span t-field="order_line.product_qty"/>
                                    <span t-field="order_line.product_uom_id" groups="uom.group_uom"/>
                                    <span t-if="order_line.product_uom_id != order_line.product_id.uom_id" class="text-muted small">
                                        <br/>
                                        <span t-field="order_line.product_uom_qty" t-options="{'widget': 'float', 'decimal_precision': 'Product Unit'}"/>
                                        <span t-field="order_line.product_id.uom_id"/>
                                    </span>
                                </td>
                            </t>
                            <t t-else="">
                                <td colspan="99" id="section">
                                    <span t-field="order_line.name"/>
                                </td>
                            </t>
                        </tr>
                    </t>
                </tbody>
            </table>
        </xpath>
    </template>
</odoo>
