<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="default_report_delivery_document_inherit" inherit_id="stock.report_delivery_document">
        <xpath expr="//h2" position="replace">
            <t t-set="check_is_default_code" t-value="o.compute_print_default_code()"/>
            <h2 style=" margin-top :30px">
                <span>Delivery slip N°</span>
                <span t-field="o.name"/>
            </h2>
        </xpath>
        <xpath expr="//div[@id='informations']" position="replace">
            <div id="informations" class="report-wrapping-flexbox clearfix row mb-4">
                <div class="col col-3 mw-100 mb-2" t-if="o.sudo().sale_id.client_order_ref">
                    <div>
                        <strong>Customer Reference:</strong>
                        <p t-field="o.sudo().sale_id.client_order_ref"/>
                    </div>
                </div>
                <div t-if="o.state" class="col col-3 mw-100 mb-2" name="div_sched_date">
                    <strong>Shipping Date:</strong>
                    <t t-if="o.state == 'done'">
                        <p t-field="o.date_done" t-options='{"format": "MM/dd/yyyy"}'/>
                    </t>
                    <t t-if="o.state != 'done'">
                        <p t-field="o.scheduled_date" t-options='{"format": "MM/dd/yyyy"}'/>
                    </t>
                </div>
                <div t-if="o.origin" class="col col-3 mw-100 mb-2" name="div_origin">
                    <strong>Order:</strong>
                    <p t-field="o.origin"/>
                </div>
            </div>
        </xpath>

        <xpath expr="//table[1]" position="replace">
            <table class="table table-sm table-borderless" t-if="o.state!='done'" name="stock_move_table">
                <thead>
                    <tr>
                        <th name="th_sm_product">
                            <strong>Product</strong>
                        </th>
                        <th name="th_sm_quantity">
                            <strong>Quantity</strong>
                        </th>
                    </tr>
                </thead>
                <tbody>
                    <t t-set="lines" t-value="o.move_ids.filtered(lambda x: x.product_uom_qty)"/>
                    <tr t-foreach="lines" t-as="move">
                        <td>
                            <span t-field="move.product_id"/>
                            <p t-if="move.description_picking != move.product_id.name">
                                <span t-field="move.description_picking"/>
                            </p>
                        </td>
                        <td>
                            <span t-esc="move.product_uom_qty"/>
                            <span t-field="move.product_uom"/>
                        </td>
                    </tr>
                </tbody>
            </table>
        </xpath>
        <xpath expr="//th[@name='th_sm_product']" position="replace">
            <th name="th_sm_ref" t-if="check_is_default_code">
                <strong>Default code</strong>
            </th>
            <th name="th_sm_product">
                <strong>Product</strong>
            </th>
        </xpath>
        <xpath expr="//th[@name='th_sml_product']" position="replace">
            <th name="th_sml_ref" t-if="check_is_default_code">
                <strong>Default code</strong>
            </th>
            <th name="th_sml_product">
                <strong>Product</strong>
            </th>
        </xpath>
        <xpath expr="//th[@name='th_sb_product']" position="replace">
            <th name="th_sb_ref" t-if="check_is_default_code">
                <strong>Default code</strong>
            </th>
            <th name="th_sb_product">
                <strong>Product</strong>
            </th>
        </xpath>
        <xpath expr="//tr[@t-as='bo_line']/td[1]/span" position="replace">
            <span t-field="bo_line.product_id.name" t-if="check_is_default_code"/>
            <span t-field="bo_line.product_id" t-if="not check_is_default_code"/>
        </xpath>
        <xpath expr="//tr[@t-as='bo_line']/td[1]" position="before">
            <td class="w-auto" t-if="check_is_default_code">
                <span t-field="bo_line.product_id.default_code"/>
            </td>
        </xpath>
        <xpath expr="//tr[@t-as='move']/td[1]" position="replace">
            <td t-if="check_is_default_code">
                <span t-field="move.product_id.default_code"/>
            </td>
            <td>
                <span t-field="move.sale_line_id.name" t-if="check_is_default_code"/>
                <span t-field="move.purchase_line_id.name" t-if="check_is_default_code"/>
                <span t-field="move.product_id" t-if="not check_is_default_code"/>
                <p t-if="move.description_picking != move.product_id.name">
                    <span t-field="move.description_picking"/>
                </p>
            </td>
        </xpath>
    </template>
