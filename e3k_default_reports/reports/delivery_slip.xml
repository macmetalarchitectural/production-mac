    <template id="stock_report_delivery_has_serial_move_line_default_reports" inherit_id="stock.stock_report_delivery_has_serial_move_line">
        <xpath expr="//td[1]" position="replace">
            <td t-if="check_is_default_code">
                <span t-field="move_line.product_id.default_code"/>
            </td>
            <td>
                <span t-field="move_line.product_id.name" t-if="check_is_default_code"/>
                <span t-field="move_line.product_id" t-if="not check_is_default_code"/>
                <t t-if="not description and description != ''">
                    <t t-set="description" t-value="move_line.move_id.description_picking"/>
                </t>
                <p t-if="description !='' and description != move_line.product_id.name">
                    <span t-esc="description"/>
                </p>
            </td>
        </xpath>
    </template>
    <template id="stock_report_delivery_aggregated_move_lines_default_reports" inherit_id="stock.stock_report_delivery_aggregated_move_lines">
        <xpath expr="//tr/td[1]" position="replace">
            <td t-if="check_is_default_code">
                <span t-esc="aggregated_lines[line]['default_code']"/>
            </td>
            <td>
                <span t-esc="aggregated_lines[line]['product_name']" t-if="check_is_default_code"/>
                <span t-esc="aggregated_lines[line]['name']" t-if="not check_is_default_code"/>
                <p t-if="aggregated_lines[line]['description']">
                    <span t-esc="aggregated_lines[line]['description']"/>
                </p>
            </td>
        </xpath>
    </template>

