<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="account_move_form_view_inherited_configuration" model="ir.ui.view">
        <field name="name">account.move.form.view.inherited.configuration</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <field name="invoice_user_id" position="before">
                <field name="invoice_print_report"/>
            </field>
            <xpath expr="//notebook" position="inside">
                <page name="invoice_text" string='Invoice Text'
                      invisible="invoice_print_report != 'summary'">
                    <field name="invoice_text" nolabel='1' widget='html'/>
                </page>
            </xpath>
        </field>
    </record>
</odoo>

