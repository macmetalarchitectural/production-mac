<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="purchase_order_form_extends" model="ir.ui.view">
        <field name="name">purchase.order.form</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/list/field[@name='date_planned']" position="before">
                   <field name="ref_seller_product_code" optional="show"/>
                   <field name="has_seller_code" column_invisible="1"/>
            </xpath>
        </field>
    </record>
</odoo>
