<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record id="res_config_settings_view_form" model="ir.ui.view">
    <field name="name">res.config.settings.view.form.inherit.sale</field>
    <field name="model">res.config.settings</field>
    <field name="inherit_id" ref="sale.res_config_settings_view_form"/>
    <field name="arch" type="xml">
      <!-- In Odoo 19, use setting id instead of div id -->
      <setting id="proforma_configuration" position="after">
        <!-- Delivery Terms & Conditions -->
        <setting id="use_delivery_terms"
                 string="Delivery Terms &amp; Conditions"
                 help="Show standard delivery terms &amp; conditions on sale orders">
          <field name="use_delivery_terms"/>
          <div class="content-group mt16" invisible="not use_delivery_terms">
            <label for="delivery_terms" class="o_light_label"/>
            <field name="delivery_terms"
                   widget="html"
                   placeholder="Insert your terms &amp; conditions here..."
                   options="{'style-inline': true}"/>
          </div>
        </setting>

        <!-- Padding Delivery Days -->
        <setting id="padding_delivery_days_setting"
                 string="Padding Delivery Days"
                 help="Additional weekdays to add when scheduling delivery dates">
          <div class="text-muted mb8">
            Minimum number of weekdays between order confirmation and delivery date
          </div>
          <div class="d-flex align-items-center gap-2">
            <label for="padding_delivery_days" string="Add" class="mb-0"/>
            <field name="padding_delivery_days" class="oe_inline" style="width: 80px;"/>
            <span>weekdays (excluding weekends)</span>
          </div>
        </setting>
      </setting>
    </field>
  </record>

</odoo>
