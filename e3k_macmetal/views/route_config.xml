<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record id="route_config_view_tree_edit" model="ir.ui.view">
    <field name="name">route.config.tree.edit</field>
    <field name="model">mac.route.config</field>
    <field name="arch" type="xml">
      <list string="Routes" editable="bottom">
        <field name="name"/>
        <field name="code"/>
      </list>
    </field>

    </record>

<!--  action-->
    <record id="route_config_action" model="ir.actions.act_window">
        <field name="name">Configuration des routes de livraison</field>
        <field name="res_model">mac.route.config</field>
        <field name="view_mode">list</field>
    </record>
<!--   and to the menu commamnde in the config menue of the sale module-->
    <menuitem id="menu_route_config" name="Routes de livraison" parent="sale.menu_sales_config" action="route_config_action"/>

</odoo>
