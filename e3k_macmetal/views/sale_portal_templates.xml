    <template id="sale_order_portal_template" inherit_id="sale.sale_order_portal_sign_modal">
      <xpath expr="//t[@t-set='default_name']" position="attributes">
        <attribute name="t-value">''</attribute>
      </xpath>
      <xpath expr="//b[@t-if='sale_order.payment_term_id']" position="replace">
        <b t-if="sale_order.payment_term_id"><span>With payment terms:</span> <b t-field="sale_order.payment_term_id"/></b>
        <b t-if="request.env['ir.config_parameter'].sudo().get_param('e3k_macmetal.use_delivery_terms')">
          <span>With delivery terms:</span> <span t-field="res_company.delivery_terms"/>
        </b>
        <span>
          <label>Customer Reference:</label> <span t-field="sale_order.client_order_ref"/>
        </span>
      </xpath>
    </template>

    <template id="sale_stock_portal_picking_state" inherit_id="sale_stock.sale_order_portal_content_inherit_sale_stock">
        <!-- Remplace le badge unique "Preparation" par deux états distincts :
             - draft/waiting/confirmed → Preparation in progress
             - assigned               → Ready -->
        <xpath expr="//div[@name='delivery_details']/span[@t-elif=&quot;picking.state in ['draft', 'waiting', 'confirmed', 'assigned']&quot;]" position="replace">
            <span t-elif="picking.state in ['draft', 'waiting', 'confirmed']"
                  class="small badge rounded-pill text-bg-info orders_label_text_align">
                <i class="fa fa-fw fa-clock-o"/>Preparation in progress
            </span>
            <span t-elif="picking.state == 'assigned'"
                  class="small badge rounded-pill text-bg-success orders_label_text_align">
                <i class="fa fa-fw fa-check"/>Ready
            </span>
        </xpath>
    </template>

  </data>
</odoo>