<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record id="view_move_line_tree" model="ir.ui.view">
    <field name="name">stock.move.line.tree</field>
    <field name="model">stock.move.line</field>
    <field name="inherit_id" ref="stock.view_move_line_tree"/>
    <field name="arch" type="xml">
      <xpath expr="//field[@name='company_id']" position="before">
        <field name="note" readonly="1"/>
        <field name="write_uid" readonly="1"/>
      </xpath>
    </field>
  </record>

  <record id="view_move_line_form" model="ir.ui.view">
    <field name="name">stock.move.line.form</field>
    <field name="model">stock.move.line</field>
    <field name="inherit_id" ref="stock.view_move_line_form"/>
    <field name="arch" type="xml">
      <xpath expr="//group/group[2]" position="after">
        <group>
          <field name="note" readonly="1"/>
          <field name="write_uid" readonly="1"/>
        </group>
      </xpath>
    </field>
  </record>

  <record id="view_stock_move_line_detailed_operation_tree_lot_ref" model="ir.ui.view">
    <field name="name">stock.move.line.operations.list.lot.ref</field>
    <field name="model">stock.move.line</field>
    <field name="inherit_id" ref="stock.view_stock_move_line_detailed_operation_tree"/>
    <field name="arch" type="xml">
      <xpath expr="//field[@name='lot_name']" position="after">
        <field name="e3k_lot_ref" groups="stock.group_production_lot"
               invisible="not lots_visible"
               readonly="state in ('done', 'cancel') and is_locked"/>
      </xpath>
    </field>
  </record>

</odoo>
