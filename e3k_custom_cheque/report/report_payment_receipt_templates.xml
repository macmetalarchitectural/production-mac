<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <template id="cheque_report_payment_receipt_document_inherit"
                  inherit_id="account.report_payment_receipt_document">
            <xpath expr="//div[hasclass('page')]//table" position="after">
                <t t-set="discount_amount" t-value="o.calculate_discount_payment()"/>
                <table class="table table-sm table-bordered" name="discount_table" t-if="discount_amount">
                    <tbody>
                        <tr>

                            <td colspan="8">
                                <strong>Escompte</strong>
                            </td>
                            <td colspan="4" class="text-end">
                                <t t-esc="discount_amount"
                                   t-options='{"widget": "monetary", "display_currency": o.company_id.currency_id}'/>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </xpath>
        </template>
    </data>
</odoo>